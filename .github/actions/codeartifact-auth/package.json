{
  "name": "codeartifact-auth",
  "version": "1.0.0",
  "description": "GitHub Action for AWS CodeArtifact authentication via OIDC",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "ncc build src/index.ts -o dist --source-map --minify",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "github-actions",
    "aws",
    "codeartifact",
    "oidc"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@aws-sdk/client-codeartifact": "^3.624.0",
    "@aws-sdk/client-sts": "^3.624.0",
    "@types/node": "^20.14.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.14.0",
    "@typescript-eslint/parser": "^7.14.0",
    "eslint": "^8.57.0",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.2.4",
    "@vercel/ncc": "^0.38.4"
  },
  "engines": {
    "node": "18.20.3"
  }
}
